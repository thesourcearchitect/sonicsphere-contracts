# ==============================================================================
# SonicSphere Contracts - Environment Template
# Copy to .env and fill in values. Never commit the real .env file.
# ==============================================================================

# RPC endpoints
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Block explorer API key (Basescan)
BASESCAN_API_KEY=

# Deployer private key -- must hold ETH for gas
# WARNING: Never use a mainnet key in plain text. Use a hardware wallet or KMS.
DEPLOYER_PRIVATE_KEY=

# Constructor / role parameters
ADMIN_ADDRESS=
GUARDIAN_ADDRESS=
RELAYER_ADDRESS=

# Risk parameters (in wei)
# TX_LIMIT must be > 0 and <= DAILY_CAP
TX_LIMIT=1000000000000000000        # 1 ETH per tx
DAILY_CAP=10000000000000000000      # 10 ETH per 24h

# Deployed vault address (populated after Deploy.s.sol runs)
# Used by: VerifyDeployment.s.sol, SetRiskParams.s.sol, EmergencyPause.s.sol
VAULT_ADDRESS=
